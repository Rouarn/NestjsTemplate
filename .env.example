# =============================================================================
# 复制为 .env 后按需修改；不要提交真实 .env
#
# 只有【必填】段没有默认值；其余项都有兜底默认值（见 src/config/validation.schema.ts），
# 可以整行删掉或注释掉。默认值集中声明在 Joi schema 里，这里列出的值即为默认值。
# =============================================================================

# ---------------------------- 必填 ----------------------------
# 两个密钥都必须 >= 32 字符且互不相同。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEST_JWT_SECRET=dev_only_access_secret_please_replace_me_32
NEST_JWT_REFRESH_SECRET=dev_only_refresh_secret_please_replace_me_32

# ---------------------------- 应用基础（可选） ----------------------------
NODE_ENV=development
NEST_APP_TITLE=NestJS Template
NEST_PORT=8848
NEST_BASE_URL=http://localhost:8848
# 反向代理层数：本机直连 0；部署在 Nginx / 负载均衡之后填 1
NEST_TRUST_PROXY=0

# ---------------------------- API 版本控制（可选） ----------------------------
NEST_API_PREFIX=api
NEST_API_DEFAULT_VERSION=1
NEST_API_VERSIONING_TYPE=header
NEST_API_VERSIONING_HEADER=X-Api-Version

# ---------------------------- JWT 有效期（可选） ----------------------------
NEST_JWT_ACCESS_TOKEN_TTL=3600
NEST_JWT_REFRESH_TOKEN_TTL=604800

# ---------------------------- 认证安全（可选） ----------------------------
NEST_BCRYPT_SALT_ROUNDS=12
NEST_AUTH_MAX_LOGIN_ATTEMPTS=5
NEST_AUTH_BASE_LOCK_DURATION=1800
NEST_AUTH_MAX_LOCK_DURATION=86400
# 令牌版本缓存 TTL（秒），0 表示每次请求查库
NEST_AUTH_TOKEN_CACHE_TTL=30

# ---------------------------- 静态资源与上传（可选） ----------------------------
# 开发期放在 deploy/ 下，保持仓库根目录干净；打包时脚本会自动归一化为 ./static、./logs
NEST_STATIC_ASSETS_DIR=./deploy/static
NEST_STATIC_ASSETS_PREFIX=/static
# MIME 白名单（逗号分隔）。留空表示不限制，但 HTML/SVG/JS 等可执行类型始终被拒绝
NEST_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
NEST_UPLOAD_MAX_SIZE=10485760
NEST_UPLOAD_MAX_FILES=10

# ---------------------------- CORS（可选） ----------------------------
# 逗号分隔的允许源；留空则不额外放行（开发环境仍允许 localhost）。不允许使用 "*"
NEST_CORS_ORIGINS=http://localhost:8848

# ---------------------------- Swagger（可选） ----------------------------
NEST_SWAGGER_TITLE=NestJS Template
NEST_SWAGGER_DESCRIPTION=API documentation for NestJS Template
NEST_SWAGGER_PREFIX=/api-docs
NEST_SWAGGER_FILENAME=api-docs.json

# ---------------------------- 数据库（可选） ----------------------------
NEST_DATABASE_HOST=127.0.0.1
NEST_DATABASE_PORT=3306
NEST_DATABASE_USER=root
NEST_DATABASE_PASSWORD=
NEST_DATABASE_NAME=nestjs_template
NEST_DATABASE_TABLE_PREFIX=ra_
# 开发环境建议 true（首次启动自动建表）；生产环境必须 false
NEST_DATABASE_SYNCHRONIZE=true
NEST_DATABASE_LOGGING=false
NEST_DATABASE_POOL_SIZE=10

# ---------------------------- 日志（可选） ----------------------------
NEST_LOGGER_LEVEL=info
NEST_LOGGER_DIR=./deploy/logs
NEST_LOGGER_MAX_FILES=14d
NEST_LOGGER_MAX_SIZE=20m
# 是否记录请求/响应体（默认 false；开启前请确认脱敏规则覆盖你的业务字段）
NEST_LOG_BODY=false

# ---------------------------- 仅 db:init 使用（可选） ----------------------------
# 初始管理员密码；留空则随机生成并只打印一次
# NEST_INIT_ADMIN_PASSWORD=
