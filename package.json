{
  "name": "nestjs-template",
  "version": "0.0.1",
  "description": "基于 NestJS 的现代化后端 API 系统，支持 JWT 认证、文件管理、数据库 ORM 等功能",
  "author": "我与夏季",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node deploy/dist/main.js",
    "build": "nest build",
    "build:prod": "cross-env NODE_ENV=production nest build",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type:check": "tsc --noEmit",
    "code:fix": "pnpm run format && pnpm run lint",
    "code:check": "pnpm run format:check && pnpm run lint:check && pnpm run type:check",
    "update": "pnpm update",
    "update:latest": "pnpm update --latest",
    "update:interactive": "pnpm update --interactive",
    "clean:tests": "node scripts/remove-spec-files.js",
    "deploy:build": "node scripts/deploy.js",
    "deploy": "pnpm run code:fix && pnpm run deploy:build",
    "g:res": "node scripts/generate-resource.js",
    "db:init": "node scripts/init-db.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "file-type": "^22.1.1",
    "joi": "^18.2.9",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nest-winston": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svg-captcha": "^1.4.0",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vakao-ui/scripts-utils": "0.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.9.0",
    "pnpm": ">=10.15.0"
  },
  "imports": {
    "#/*": "./deploy/dist/*"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,css,scss,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
