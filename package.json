{
  "name": "nestjs-template",
  "version": "0.0.1",
  "description": "基于 NestJS 的现代化后端 API 系统，支持 JWT 认证、文件管理、数据库 ORM 等功能",
  "author": "我与夏季",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:test": "cross-env NODE_ENV=test nest start",
    "start:test-watch": "cross-env NODE_ENV=test nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "build": "nest build",
    "build:dev": "cross-env NODE_ENV=development nest build",
    "build:prod": "cross-env NODE_ENV=production nest build",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type:check": "tsc --noEmit",
    "code:fix": "pnpm run format && pnpm run lint",
    "code:check": "pnpm run format:check && pnpm run lint:check && pnpm run type:check",
    "update": "pnpm update",
    "update:latest": "pnpm update --latest",
    "update:interactive": "pnpm update --interactive",
    "clean:tests": "node scripts/remove-spec-files.js",
    "deploy:prepare": "node scripts/deploy.js",
    "deploy:build": "pnpm run build:prod && pnpm run deploy:prepare",
    "deploy": "pnpm run code:fix && pnpm run deploy:build",
    "g:res": "node scripts/generate-resource.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/typeorm": "^11.0.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "file-type": "^22.0.1",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.2",
    "svg-captcha": "^1.4.0",
    "typeorm": "^1.0.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/swagger": "^11.4.4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vakao-ui/scripts-utils": "0.0.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.9.0",
    "pnpm": ">=10.15.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,css,scss,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
